{
  "name": "figma-token-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Local Figma plugin + bridge server for two-way sync between Figma Variables and a design-token JSON folder on disk.",
  "license": "MIT",
  "author": "Anatolii Atamanov",
  "repository": {
    "type": "git",
    "url": "https://github.com/shtol1k/figma-token-bridge.git"
  },
  "keywords": ["figma", "figma-plugin", "design-tokens", "design-system", "dtcg"],
  "scripts": {
    "build:server": "tsc -p server/tsconfig.json",
    "build:plugin": "tsc -p plugin/tsconfig.json",
    "build:css": "tailwindcss -i plugin/ui.src.css -o plugin/ui.css --minify",
    "build:ui": "node scripts/build-ui.mjs",
    "build": "pnpm run build:server && pnpm run build:plugin && pnpm run build:css && pnpm run build:ui",
    "start": "node dist/server/index.js",
    "dev": "pnpm run build && pnpm run start",
    "type-check": "tsc -p server/tsconfig.json --noEmit && tsc -p plugin/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.100.0",
    "@tailwindcss/cli": "^4.0.0",
    "@types/node": "^20.14.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0"
  }
}
